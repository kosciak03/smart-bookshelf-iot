generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookStatus {
  WANT_TO_READ
  READING
  READ
}

enum LocationStatus {
  UNASSIGNED
  ON_SHELF
  CHECKED_OUT
}

model Book {
  id             String         @id @default(uuid())
  isbn           String?        @unique
  title          String
  author         String
  description    String?
  coverUrl       String?
  pageCount      Int?
  pagesRead      Int            @default(0)
  rating         Int?
  status         BookStatus     @default(WANT_TO_READ)
  locationStatus LocationStatus @default(UNASSIGNED)
  rfidUid        String?        @unique
  slotId         String?        @unique
  slot           ShelfSlot?     @relation(fields: [slotId], references: [id])
  events         ShelfEvent[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ShelfSlot {
  id           String       @id @default(uuid())
  shelfNumber  Int
  slotNumber   Int
  ledStartIdx  Int
  ledEndIdx    Int
  fsrPin       Int
  isOccupied   Boolean      @default(false)
  isHighlighted Boolean     @default(false)
  book         Book?
  events       ShelfEvent[]

  @@unique([shelfNumber, slotNumber])
}

model ShelfEvent {
  id        String     @id @default(uuid())
  type      String
  bookId    String?
  book      Book?      @relation(fields: [bookId], references: [id])
  slotId    String?
  slot      ShelfSlot? @relation(fields: [slotId], references: [id])
  createdAt DateTime   @default(now())
}
