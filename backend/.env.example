DATABASE_URL="postgresql://bookshelf_admin:bookshelf_secret_password@localhost:5432/smart_bookshelf?schema=public"
PORT=3000
# MQTT broker shared with the ESP32 shelf (empty = shelf integration disabled)
MQTT_URL="mqtt://localhost:1883"
CORS_ORIGIN="http://localhost:5173"
# Optional: Google Books API key (without it the shared anonymous quota is often exhausted)
GOOGLE_BOOKS_API_KEY=""
# Time zone used to group reading statistics by month/year
APP_TIMEZONE="Europe/Warsaw"
